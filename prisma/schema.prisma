generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PlannedBillOccurrenceStatus {
  PAID
  SKIPPED
}

enum PlannedBillOccurrencePaymentSource {
  GENERATED
  LINKED
}

enum PlannedIncomeOccurrenceStatus {
  RECEIVED
  SKIPPED
}

enum PlannedIncomeOccurrencePaymentSource {
  GENERATED
  LINKED
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String?                 @unique
  emailVerified          DateTime?
  image                  String?
  currency               String                  @default("EUR")
  hasCompletedSetup      Boolean                 @default(false)
  accounts               Account[]
  sessions               Session[]
  categories             Category[]
  transactions           Transaction[]
  balanceAdjustments     BalanceAdjustment[]
  plannedBills           PlannedBill[]
  plannedBillOccurrences PlannedBillOccurrence[]
  plannedIncomes         PlannedIncome[]
  plannedIncomeOccurrences PlannedIncomeOccurrence[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model BalanceAdjustment {
  id             String   @id @default(cuid())
  userId         String
  amount         Decimal  @db.Decimal(14, 2)
  effectiveMonth String
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveMonth])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id           String          @id @default(cuid())
  userId       String
  name         String
  type         TransactionType
  isArchived   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  plannedBills PlannedBill[]
  plannedIncomes PlannedIncome[]
  tags         Tag[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id         String          @id @default(cuid())
  userId     String
  type       TransactionType
  amount     Decimal         @db.Decimal(14, 2)
  localDate  String
  categoryId String
  tagId      String?
  source     String?
  note       String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tag        Tag?            @relation(fields: [tagId], references: [id], onDelete: SetNull)
  plannedBillOccurrence PlannedBillOccurrence?
  plannedIncomeOccurrence PlannedIncomeOccurrence?

  @@index([userId, localDate])
  @@index([categoryId, localDate])
  @@index([userId, tagId, localDate])
}

model Tag {
  id           String        @id @default(cuid())
  categoryId   String
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  plannedBills PlannedBill[]
  plannedIncomes PlannedIncome[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model PlannedBill {
  id            String                  @id @default(cuid())
  userId        String
  name          String
  amount        Decimal                 @db.Decimal(14, 2)
  dueDayOfMonth Int
  categoryId    String
  tagId         String?
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tag           Tag?                    @relation(fields: [tagId], references: [id], onDelete: SetNull)
  occurrences   PlannedBillOccurrence[]

  @@index([userId, isActive])
  @@index([userId, dueDayOfMonth])
  @@index([userId, tagId])
}

model PlannedBillOccurrence {
  id              String                      @id @default(cuid())
  userId          String
  plannedBillId   String
  month           String
  status          PlannedBillOccurrenceStatus
  transactionId   String?                     @unique
  paidAtLocalDate String?
  paymentSource   PlannedBillOccurrencePaymentSource?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedBill     PlannedBill                 @relation(fields: [plannedBillId], references: [id], onDelete: Cascade)
  transaction     Transaction?                @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([plannedBillId, month])
  @@index([userId, month])
  @@index([userId, status])
}

model PlannedIncome {
  id                 String                    @id @default(cuid())
  userId             String
  name               String
  amount             Decimal                   @db.Decimal(14, 2)
  expectedDayOfMonth Int
  categoryId         String
  tagId              String?
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category           Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tag                Tag?                      @relation(fields: [tagId], references: [id], onDelete: SetNull)
  occurrences        PlannedIncomeOccurrence[]

  @@index([userId, isActive])
  @@index([userId, expectedDayOfMonth])
  @@index([userId, tagId])
}

model PlannedIncomeOccurrence {
  id                  String                               @id @default(cuid())
  userId              String
  plannedIncomeId     String
  month               String
  status              PlannedIncomeOccurrenceStatus
  transactionId       String?                              @unique
  receivedAtLocalDate String?
  paymentSource       PlannedIncomeOccurrencePaymentSource?
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt
  user                User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedIncome       PlannedIncome                        @relation(fields: [plannedIncomeId], references: [id], onDelete: Cascade)
  transaction         Transaction?                         @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([plannedIncomeId, month])
  @@index([userId, month])
  @@index([userId, status])
}
